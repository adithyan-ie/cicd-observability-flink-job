# Copy to .env and fill in before running `docker compose up -d`.

# This EC2 instance's own address, as reachable from the flink-job and
# jenkins EC2 instances. Kafka embeds this in the metadata it hands back
# to remote clients (advertised.listeners) — get it wrong and remote
# producers/consumers will fail after the first request.
#   - Same-VPC deployment (recommended): this instance's PRIVATE IP.
#   - Cross-VPC / over the public internet: this instance's PUBLIC or
#     Elastic IP (and you'll need a much tighter security group).
DATA_LAYER_HOST=10.0.1.10
